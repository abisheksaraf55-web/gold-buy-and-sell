rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId}/transactions/{transactionId} {
      allow list: if isOwner(userId);
      allow get, write: if isOwner(userId) && isValidId(transactionId);
    }

    match /users/{userId}/shopDetails/{shopId} {
      allow list: if isOwner(userId);
      allow get, write: if isOwner(userId) && isValidId(shopId);
    }

    match /users/{userId}/marketRates/{rateId} {
      allow list: if isOwner(userId);
      allow get, write: if isOwner(userId) && isValidId(rateId);
    }
  }
}
